# ==============================================================================
# portal-integra-sinc — variáveis de ambiente
#
# Copie para .env e preencha. Este arquivo (.env.example) é versionado e NÃO
# contém segredo; o .env fica fora do git.
#
# A APLICAÇÃO NUNCA ESCREVE AQUI. A tela não tem campos de conexão: quem edita
# é quem opera a máquina. Depois de alterar, reinicie o processo — a
# configuração é lida uma vez, no start.
# ==============================================================================

# ── DESTINO: PostgreSQL do Portal Integra ─────────────────────────────────────
# É o banco em que o sincronizador GRAVA. Aponte para a instância que o Portal
# usa. Confira duas vezes: gravar no banco errado não dá erro nenhum.
#
# Use um usuário dedicado, com permissão nas tabelas sincronizadas.
# NÃO use `postgres` nem outro superusuário.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=portalintegra_app
DATABASE_PASSWORD=
DATABASE_NAME=portalintegra

# O mesmo do Portal. Não reduza: ao terminar uma sincronização a tela recarrega
# tudo de uma vez (listagem, nove `pendentes`, diagnóstico e histórico), e com
# pool pequeno o PostgreSQL responde "connection pool exhausted".
DB_POOL_MIN=1
DB_POOL_MAX=20

# Teto para CONECTAR (segundos) e para CONSULTAR (milissegundos).
# 0 no segundo desliga o teto por consulta.
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=300000

# ── ORIGEM: Domínio / SQL Anywhere (somente leitura) ──────────────────────────
# Informe DOMINIO_DSN (+ usuário e senha) OU DOMINIO_CONNSTR, para o caso de
# uma string ODBC completa. DOMINIO_CONNSTR tem precedência.
#
# O DSN precisa existir no Gerenciador de Fontes de Dados ODBC de 64 BITS do
# Windows, apontando para o driver do SQL Anywhere. DSN criado no gerenciador
# de 32 bits falha com "incompatibilidade de arquiteturas entre o Driver e o
# Aplicativo" (IM014) — é o erro mais comum nesta instalação. O README mostra
# como criar o de 64 bits sem privilégio de administrador.
#
# Um DSN de USUÁRIO só existe para a conta que o criou. Quando a sincronização
# passar a rodar pelo Agendador de Tarefas com conta de serviço, use o
# DOMINIO_CONNSTR abaixo — ele independe de conta e de registro.
#
# A conta deve ter permissão apenas de LEITURA no Domínio.
#
# NUM SERVIDOR, prefira DOMINIO_CONNSTR com o HOST FIXO. Sem o host, o
# `CommLinks=TCPIP{serverport=2638}` procura o servidor por BROADCAST UDP na
# sub-rede local — funciona na máquina do escritório e falha em qualquer
# servidor que esteja em outra VLAN ou com broadcast filtrado, com um erro que
# se parece com "servidor não encontrado".
#
#   DOMINIO_CONNSTR=DRIVER={SQL Anywhere 17};CommLinks=TCPIP{host=<ip>;port=2638};ServerName=srvContabil;DatabaseName=Contabil;UID=<usuario>;PWD=<senha>
#
# E o DSN, se usado, só vale para a conta que o criou — uma tarefa agendada sob
# outra conta falha com IM002. A connstr independe de conta.
DOMINIO_DSN=
DOMINIO_CONNSTR=
DOMINIO_USER=
DOMINIO_PASSWORD=

# O schema das tabelas do Domínio. Atenção: hoje isto só afeta a importação de
# empresas — as 23 consultas copiadas do Portal trazem `bethadba` escrito no
# corpo do SQL. Trocar aqui não troca lá.
DOMINIO_SCHEMA=bethadba

# ── Os dois tetos da sincronização contábil ───────────────────────────────────
# Teto de empresas por execução. 0 DESLIGA, e é o default: a carga em lote é o
# trabalho deste processo. No Portal o teto é 20 por causa do gunicorn, que
# aqui não existe. O que protege contra execução duplicada é a trava de sessão
# do PostgreSQL, não o teto.
#
# Atenção: NÃO há barra de progresso. Uma rodada longa aparece como um fetch
# pendurado no navegador — medido, os lançamentos de UMA empresa grande levam
# ~2 minutos só de leitura. Quem quiser o freio de volta põe um número.
SINC_TETO_DE_EMPRESAS=0

# Ano corrente e os N-1 anteriores, na importação de lançamentos.
# TEM de concordar com o `janela()` do portal-integra: os dois escrevem em
# bi_lancamento, e divergir faz o aviso de "período anterior à janela" mentir.
SINC_ANOS_JANELA=3

# ── Agendamento ───────────────────────────────────────────────────────────────
# Expressão cron do daemon `sincronizar.py --serve`, no fuso de TZ.
# SÓ vale nesse modo: quem agenda pelo Agendador de Tarefas do Windows define o
# horário LÁ, e este campo é ignorado.
SINC_CRON=0 2 * * *

# ── Operação ──────────────────────────────────────────────────────────────────
# A porta da tela. 7820 e não 7810 porque o Portal pode estar no ar na mesma
# máquina. O endereço é sempre 127.0.0.1 e NÃO é configurável — ver
# SERVIDOR_HOST em app/__init__.py.
APP_PORT=7820
FLASK_DEBUG=false

LOG_LEVEL=INFO
TZ=America/Cuiaba

# Interruptor de emergência da Content-Security-Policy. `false` volta a
# política para observação (Report-Only) sem alterar código.
CSP_ENFORCE=true
